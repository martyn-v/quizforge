    "@langchain/ollama": "1.3.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "7.9.1",
    "@quizforge/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "prisma": "7.9.1",
    "tsx": "^4.20.0",
