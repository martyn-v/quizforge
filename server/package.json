    "db:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@langchain/core": "^1.2.4",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "^1.4.9",
