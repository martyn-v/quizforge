{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "spike": "tsx spike/langgraph-spike.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
