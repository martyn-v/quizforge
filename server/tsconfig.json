{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // vitest runs with globals: true, so describe/it/expect need to be typed
    // as globals too. Listing "node" as well because setting `types` at all
    // narrows what TypeScript picks up automatically.
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "spike", "prisma.config.ts", "vitest.config.ts", "vitest.setup.ts"]
}
