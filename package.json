{
  "name": "quizforge",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . && pnpm typecheck",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter server --filter shared --filter evals --filter web typecheck",
    "dev": "process-compose up",
    "dev:down": "process-compose down",
    "dev:raw": "pnpm --parallel --filter server --filter web dev",
    "test": "pnpm --filter server --filter shared --filter evals test",
    "eval": "pnpm --filter evals eval",
    "eval:fixtures": "pnpm --filter evals fixtures",
    "eval:judge": "pnpm --filter evals judge",
    "prisma": "pnpm --filter server exec prisma"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "typescript-eslint": "8.66.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
