{
  "name": "quizforge",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "process-compose up",
    "dev:down": "process-compose down",
    "dev:raw": "pnpm --parallel --filter server --filter web dev",
    "test": "pnpm --filter server --filter shared test",
    "prisma": "pnpm --filter server exec prisma"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "typescript-eslint": "8.66.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
