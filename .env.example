# LLM provider seam: "ollama" (local, no key needed) or "groq"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Postgres. The POSTGRES_* vars configure the docker compose container,
# DATABASE_URL is what the app connects with. Keep them in agreement.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quizforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quizforge

# Agent config
GENERATION_STRATEGY=single-pass
SCORING_MODE=spec

# Eval judge. The judge grades generated quizzes, so give it a different
# model than the generator. JUDGE_PROVIDER is "ollama" or "groq".
JUDGE_PROVIDER=ollama
JUDGE_OLLAMA_MODEL=
JUDGE_GROQ_MODEL=llama-3.3-70b-versatile
