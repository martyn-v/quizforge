# LLM provider seam: "ollama" (local, no key needed) or "groq"
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:31b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional generation tuning. Empty keeps the provider defaults.
# LLM_THINK=false turns reasoning off for thinking models (Ollama only).
LLM_TEMPERATURE=
LLM_THINK=

# Postgres. The POSTGRES_* vars configure the docker compose container,
# DATABASE_URL is what the app connects with. Keep them in agreement.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quizforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quizforge

# Agent config
GENERATION_STRATEGY=single-pass
SCORING_MODE=spec

# Observability. Set LANGSMITH_TRACING=true and add an API key to send
# traces to LangSmith. Keep it false without a key, or the trace queue
# logs a warning on each run. Eval runs trace to "<project>-evals".
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Eval judge. The judge grades generated quizzes, so give it a different
# model than the generator. JUDGE_PROVIDER is "ollama" or "groq".
JUDGE_PROVIDER=ollama
JUDGE_OLLAMA_MODEL=
JUDGE_GROQ_MODEL=llama-3.3-70b-versatile
# The judge runs at temperature 0 with reasoning off. Set JUDGE_THINK=true
# to let a thinking model reason. Both settings are optional.
JUDGE_TEMPERATURE=0
JUDGE_THINK=false
