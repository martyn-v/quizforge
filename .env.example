# quizforge environment. Copy this file to .env and fill in the blanks.
# The server and the eval harness both read .env. An empty value keeps
# the default that the comment names.

# --- Generation LLM ---
# LLM_PROVIDER selects the provider seam: "ollama" (local, no key
# needed) or "groq".
LLM_PROVIDER=ollama
# OLLAMA_MODEL is the generation model when LLM_PROVIDER=ollama. The
# model must be installed: ollama pull <model>.
OLLAMA_MODEL=gemma4:31b
# GROQ_API_KEY authenticates every Groq call. Create a key at
# https://console.groq.com. The free tier enforces per-minute and
# per-day token limits, and an eval run can exhaust the daily limit.
GROQ_API_KEY=
# GROQ_MODEL is the generation model when LLM_PROVIDER=groq.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional generation tuning. Empty keeps the provider defaults.
# LLM_TEMPERATURE is a number. Use 0 for reproducible output.
# LLM_THINK=false turns reasoning off for thinking models (Ollama only).
LLM_TEMPERATURE=
LLM_THINK=

# --- Postgres ---
# The POSTGRES_* variables configure the docker compose container.
# DATABASE_URL is the connection string the app and Prisma use. Keep
# the two in agreement.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quizforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quizforge

# --- Agent ---
# GENERATION_STRATEGY selects the generation strategy. "single-pass"
# (default) makes one generation call for the whole document. "chunked"
# generates per section and merges the results. The strategies live in
# server/src/agent/strategies. The server rejects unknown values at
# startup.
GENERATION_STRATEGY=single-pass
# SCORING_MODE selects the multi-answer scoring rule: "spec" (the
# specified rule, default), "scaled" or "penalized". The rules live in
# server/src/scoring/scoring-modes.ts. The server rejects unknown
# values at startup.
SCORING_MODE=spec

# --- Observability ---
# Set LANGSMITH_TRACING=true and add an API key to send traces to
# LangSmith. Keep it false without a key, or the trace queue logs a
# warning on each run.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT names the trace project. Eval runs trace to
# "<project>-evals", which keeps eval batches out of the live stream.
LANGSMITH_PROJECT=

# --- Eval judge ---
# The judge grades generated quizzes, so give it a model different from
# the generator model. JUDGE_PROVIDER is "ollama" or "groq".
JUDGE_PROVIDER=ollama
# JUDGE_OLLAMA_MODEL is required when JUDGE_PROVIDER=ollama. There is
# no default on purpose: an accidental match with the generator model
# would let a model grade its own output.
JUDGE_OLLAMA_MODEL=
JUDGE_GROQ_MODEL=llama-3.3-70b-versatile
# The judge runs at temperature 0 with reasoning off, for reproducible
# verdicts. Set JUDGE_THINK=true to let a thinking model reason.
JUDGE_TEMPERATURE=0
JUDGE_THINK=false
